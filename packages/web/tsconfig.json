{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*", "../shared/**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"composite": true,
		"module": "ESNext",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
