name = "cloudflare-effect-better-auth-api"
main = "packages/api/src/index.ts"
compatibility_date = "2025-01-17"
compatibility_flags = ["nodejs_compat"]

[observability]
enabled = true

# D1 Database binding
# Create your D1 database: wrangler d1 create cloudflare-effect-better-auth
# Then copy the database_id from the output
[[d1_databases]]
binding = "DB"
database_name = "cloudflare-effect-better-auth"
database_id = "<YOUR_D1_DATABASE_ID>"

# Secrets (set via: wrangler secret put SECRET_NAME)
# For local development, use .dev.vars file (already in .gitignore)
#
# Required secrets:
# - BETTER_AUTH_SECRET
# - BETTER_AUTH_URL
